# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.

# Hugging Face (pyannote, quién habla): https://huggingface.co/settings/tokens
HF_TOKEN=

# Cohere (LLM): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Anthropic (LLM opcional, provider: anthropic en configs/llm.yaml)
ANTHROPIC_API_KEY=

# Worker en Modal: contraseña compartida entre el worker y el backend, y código para subir videos
WORKER_TOKEN=
UPLOAD_ACCESS_CODE=

# URL del backend (opcional): si está, el worker le avisa al terminar cada video
API_BASE_URL=
